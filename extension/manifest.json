{
  "manifest_version": 3,
  "name": "Readlater",
  "short_name": "Readlater",
  "version": "1.0.0",
  "description": "Save the page you are on to Readlater, including the rendered page, with tags and a category.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Save to Readlater",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib.js", "background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "activeTab", "scripting", "contextMenus", "tabs"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save this page and open the Readlater popup"
    },
    "save-page": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Save this page to Readlater without opening the popup"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "readlater@readlater.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "browsingActivity"]
      }
    }
  }
}
