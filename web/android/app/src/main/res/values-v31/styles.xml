<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows a system splash; keep it a static white screen with the icon. -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/readlater_white</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/readlater_white</item>
    </style>
</resources>
